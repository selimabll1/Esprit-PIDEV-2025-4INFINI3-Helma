        "body": {
          "mode": "raw",
          "raw": "{\n  \"beneficiaryName\": \"Ahmed Bennour\",\n  \"beneficiaryRib\": \"98765432TNZ\",\n  \"amount\": 1000,\n  \"type\": \"EXTERNAL\",\n  \"category\": \"LOYER\",\n  \"description\": \"Paiement loyer (SANS DATE!)\",\n  \"periodicity\": \"SCHEDULED\"\n}"
        },
        "url": {
          "raw": "http://localhost:8082/helma/transactions/add/1",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8082",
          "path": [
            "helma",
            "transactions",
            "add",
            "1"
          ]
        },
        "description": "❌ Mode SCHEDULED sans scheduledDate:\n- scheduledDate est OBLIGATOIRE pour SCHEDULED\n- Rejeté avec message d'erreur détaillé\n\nRésultat attendu: 400 Bad Request\nMessage: \"❌ Mode SCHEDULED obligatoire: 'scheduledDate' est REQUISE...\\nExemple: { \\\"periodicity\\\": \\\"SCHEDULED\\\", \\\"scheduledDate\\\": \\\"2026-02-22T10:00:00\\\" }\""
      },
      "response": []
    },
