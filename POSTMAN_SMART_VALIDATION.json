            "add",
            "1"
          ]
        },
        "description": "❌ Mode SCHEDULED avec date passée:\n- scheduledDate doit être FUTURE\n- Les dates passées sont rejetées\n\nRésultat attendu: 400 Bad Request\nMessage: \"La date programmée doit être dans le futur\""
      },
      "response": []
    },
    {
      "name": "✅ VALID - PERMANENT (avec nextExecutionDate)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "*/*",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"beneficiaryName\": \"Orange Telecom\",\n  \"beneficiaryRib\": \"11111111TNZ\",\n  \"amount\": 50,\n  \"type\": \"EXTERNAL\",\n  \"category\": \"ABONNEMENT\",\n  \"description\": \"Abonnement mobile récurrent\",\n  \"periodicity\": \"PERMANENT\",\n  \"nextExecutionDate\": \"2026-03-21T00:00:00\"\n}"
        },
        "url": {
          "raw": "http://localhost:8082/helma/transactions/add/1",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8082",
          "path": [
            "helma",
            "transactions",
            "add",
            "1"
          ]
        },
        "description": "✅ Mode PERMANENT (récurrent):\n- nextExecutionDate OPTIONNELLE (fournie ici)\n- Montant débité/crédité IMMÉDIATEMENT (1ère exécution)\n- Status = CONFIRMED\n- Prochaine exécution programmée à nextExecutionDate\n- lastExecutionDate = maintenant\n\nRésultat attendu: 200 OK avec status=CONFIRMED"
      },
      "response": []
    },
    {
      "name": "✅ VALID - PERMANENT (sans nextExecutionDate, défaut auto)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "*/*",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"beneficiaryName\": \"Maroc Telecom\",\n  \"beneficiaryRib\": \"22222222TNZ\",\n  \"amount\": 75,\n  \"type\": \"EXTERNAL\",\n  \"category\": \"ABONNEMENT\",\n  \"description\": \"Abonnement internet (défaut auto +30j)\",\n  \"periodicity\": \"PERMANENT\"\n}"
        },
        "url": {
          "raw": "http://localhost:8082/helma/transactions/add/1",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8082",
          "path": [
            "helma",
            "transactions",
            "add",
            "1"
          ]
        },
        "description": "✅ Mode PERMANENT sans nextExecutionDate:\n- nextExecutionDate OPTIONNELLE (absente ici)\n- Le serveur auto-calcule: nextExecutionDate = LocalDateTime.now() + 30 jours\n- Montant débité/crédité IMMÉDIATEMENT\n- Status = CONFIRMED\n\nRésultat attendu: 200 OK\nLa réponse inclura nextExecutionDate auto-calculée (~30j à partir de maintenant)"
      },
      "response": []
    },
